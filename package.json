{
  "name": "npl-fan-zone",
  "private": true,
  "version": "1.0.0",
  "description": "NPL Fan Zone - an independent fan website for the Nepal Premier League",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sql": "node scripts/verify-sql.mjs",
    "test:bundle": "node scripts/verify-production-bundle.mjs",
    "test:release": "npm test && npm run test:sql && npm run build && npm run test:bundle",
    "seed:sql": "node scripts/generate-seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
