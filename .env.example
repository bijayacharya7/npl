# ---------------------------------------------------------------------------
# NPL Fan Zone environment variables
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).
#
# ONLY these two variables are meant for the browser. The "anon"/"publishable"
# key is safe to expose because Row Level Security protects your data.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Local demo only. The admin/admin shortcut and browser-only storage are never
# enabled by production builds. Set false in development to test Supabase auth/data.
VITE_LOCAL_DEMO=true

# Leave BOTH empty to run the app in LOCAL DEMO MODE (no Supabase needed).
# Local demo mode stores data in your browser and is clearly labelled as demo.

# ---------------------------------------------------------------------------
# NEVER put a service-role key, database password, or any secret in a
# VITE_-prefixed variable: every VITE_ value is compiled into browser code.
# ---------------------------------------------------------------------------

# CricketData.org — server only. Copy to `.env` locally. Never prefix with VITE_.
CRICKETDATA_API_KEY=
CRICKETDATA_DAILY_LIMIT=80

# Optional: persist the shared API cache in Supabase (recommended in production).
# Use the service role on the server only. The browser keeps using the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: shared secret for the hourly refresh job.
CRON_SECRET=
